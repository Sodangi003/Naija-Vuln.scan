# Copy this file to .env and fill in real values before running in production.
# Never commit the real .env file to git.

SECRET_KEY=generate-a-long-random-string-here
DATABASE_URL=sqlite:///./naijavulnscan.db

TRIAL_DAYS=7
SUBSCRIPTION_PRICE_NGN=5000
SUBSCRIPTION_PERIOD_DAYS=30

# Get these from https://dashboard.paystack.com/#/settings/developer
# Use the sk_test_/pk_test_ keys until you're ready to accept real payments.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Change this to your real domain once deployed (used in payment callback URLs)
APP_BASE_URL=http://localhost:8000
